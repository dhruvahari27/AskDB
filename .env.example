# ---------- Databases (defaults match `npm run db:embedded`, port 5434) ----------
# App DB: users, conversations, runs, glossary, feedback, LangGraph checkpoints.
APP_DATABASE_URL=postgres://askdb:askdb@localhost:5434/askdb_app
# Warehouse owner: only used by `npm run setup` to create/load tables.
WAREHOUSE_ADMIN_URL=postgres://askdb:askdb@localhost:5434/askdb_warehouse
# Read-only role the agent uses. The generated SQL can only ever run as this role.
WAREHOUSE_READONLY_URL=postgres://askdb_ro:askdb_ro@localhost:5434/askdb_warehouse

# ---------- API ----------
# API port
PORT=4711
# Where the browser app runs in development (CORS). In production the API serves the built web app itself.
# Dev web server port (apps/web) and the origin the API allows. Keep them in sync.
WEB_PORT=4710
CLIENT_ORIGIN=http://localhost:4710
# CHANGE THIS. Use a long random string, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me-to-a-long-random-string
# Max LLM tokens per user per day (input + output). 0 = unlimited.
DAILY_TOKEN_BUDGET=200000
# Requests per minute per user (ask endpoint)
ASK_RATE_LIMIT_PER_MIN=20

# ---------- LLM ----------
# mock   = no API key needed, deterministic demo answers (NOT for evals or real use)
# groq   = Groq free tier (https://console.groq.com)
# gemini = Google Gemini free tier (https://aistudio.google.com)
LLM_PROVIDER=mock
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional: cache LLM responses (keeps eval reruns cheap and reproducible). Leave empty to use a local file cache.
REDIS_URL=

# ---------- SQL safety ----------
STATEMENT_TIMEOUT_MS=5000
MAX_RESULT_ROWS=500
# EXPLAIN total-cost ceiling; queries planned above this are rejected
MAX_PLAN_COST=5000000
